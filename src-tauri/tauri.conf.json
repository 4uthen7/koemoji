{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KoeMoji",
  "version": "0.1.0",
  "identifier": "com.koemoji.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KoeMoji — Dev 高本 4uthent / tkmt_wonderkid",
        "width": 940,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "mp3",
          "wav",
          "m4a",
          "aac",
          "flac",
          "ogg",
          "aiff"
        ],
        "name": "KoeMoji Audio",
        "description": "音声ファイルを KoeMoji で文字起こし"
      },
      {
        "ext": [
          "mp4",
          "m4v",
          "mov",
          "mkv",
          "webm",
          "avi",
          "wmv"
        ],
        "name": "KoeMoji Video",
        "description": "動画ファイルを KoeMoji で文字起こし"
      }
    ]
  }
}
